{
  "name": "checkthisout",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Spotify music discovery PWA",
  "scripts": {
    "start": "node server.cjs",
    "build": "node scripts/build.mjs",
    "test": "node --test backend/worker.test.mjs history.test.mjs recommendations.test.mjs",
    "test:e2e": "node smoke-test.cjs && node spotify-test.cjs && node discovery-test.cjs && node history-open-test.cjs && node backup-test.cjs",
    "deploy": "node scripts/build.mjs && wrangler deploy --config wrangler.app.toml"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.11.0",
  "type": "module"
}
